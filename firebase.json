{
"functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "europe-west1"
    },
    "rewrites": [
      { "source": "/analysis/food-analysis", "destination": "/analysis/food-analysis.html" },
      { "source": "/analysis/recipe-analysis", "destination": "/analysis/recipe-analysis.html" },
      { "source": "/analysis/menu-analysis", "destination": "/analysis/menu-analysis.html" },
      { "source": "/auth/basic_auth", "destination": "/auth/basic_auth.html" },
      { "source": "**", "function": "app" }
    ]
  }
}

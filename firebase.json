{
"functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "frameworksBackend": {
      "region": "europe-west1"
    },
    "rewrites": [
      { "source": "/api/**", "function": "app" },
      { "source": "/foods/**", "function": "app" },
      { "source": "/recipes/**", "function": "app" },
      { "source": "/users/**", "function": "app" },
      { "source": "/menus/**", "function": "app" }
    ]
  }
}
